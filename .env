# Project Uzima local settings. Never commit this file (.gitignore covers it).
# Loaded by scripts/dev.sh with bash: inline comments are fine; quote any value that contains spaces.
# Empty credential = that integration stays on its mock.

# ============================================================
# AWS (including Bedrock)
# No Bedrock variables are used by the code.
# ============================================================
USE_AWS=0                                   # set to 1 to turn on DynamoDB + AWS Location
AWS_REGION=us-east-1                        # region where you created the resources below (AWS Console, top-right)
DYNAMODB_TABLE=project-uzima                # AWS Console > DynamoDB > Tables (create from infra/aws/dynamodb-table.json)
AWS_LOCATION_ROUTE_CALCULATOR=project-uzima-routes  # AWS Console > Amazon Location > Route calculators
AWS_LOCATION_MAP=project-uzima-map          # AWS Console > Amazon Location > Maps
LAUNCH_MODE=local                           # local = in-process swarm; k8s = one Job per hospital
AGENT_IMAGE=project-uzima/agent:latest      # AWS Console > ECR > repository URI (only for k8s mode)
K8S_NAMESPACE=project-uzima                 # from infra/k8s/namespace.yaml (only for k8s mode)

# ============================================================
# OpenAI
# ============================================================
OPENAI_API_KEY=                             # platform.openai.com > API keys > Create new secret key
OPENAI_MODEL=                               # platform.openai.com > Limits page: a chat model your account can use
OPENAI_MAX_CONCURRENT=5                     # our own rate limit; no lookup needed
OPENAI_REALTIME_MODEL=gpt-realtime          # platform.openai.com > Models (Realtime)
OPENAI_REALTIME_VOICE=alloy                 # OpenAI Realtime docs > voices
LIVE_CALL_MAX_S=240                         # our own cap on one live call, seconds

# ============================================================
# Twilio
# ============================================================
TWILIO_ACCOUNT_SID=                         # Twilio Console home page > Account Info
TWILIO_AUTH_TOKEN=                          # Twilio Console home page > Account Info (click "show")
TWILIO_FROM_NUMBER=                         # Twilio Console > Phone Numbers > Active numbers (E.164, e.g. +1...)
DEMO_HOSPITAL_PHONES=                       # teammates' phones, comma list, each verified in Twilio Console > Verified Caller IDs
DEMO_HOSPITAL_PHONE=                        # legacy single phone; used only if DEMO_HOSPITAL_PHONES is empty
DEMO_SENDING_DOCTOR_PHONE=                  # referring clinician's phone (verified caller ID); Connect dials this
DEMO_ACCEPTING_DOCTOR_PHONE=                # verified caller ID; used only if the winner was a simulated hospital

# ============================================================
# ngrok / public URL
# ============================================================
PUBLIC_HOST=                                # host shown by `ngrok http 8002`, without https:// (e.g. abcd.ngrok-free.app)

# ============================================================
# Stedi (insurance check, mock mode)
# ============================================================
STEDI_TEST_API_KEY=                         # Stedi portal > API keys (test-mode key only)
STEDI_MOCK_PAYER_ID=                        # Stedi docs > eligibility mock requests (payer ID)
STEDI_MOCK_MEMBER_ID=                       # Stedi docs > eligibility mock requests (member ID)
STEDI_MOCK_FIRST=                           # Stedi docs > eligibility mock requests (first name)
STEDI_MOCK_LAST=                            # Stedi docs > eligibility mock requests (last name)
STEDI_MOCK_DOB=                             # Stedi docs > eligibility mock requests (date of birth)

# ============================================================
# Handoff (SMART Health Link record)
# ============================================================
SHL_VIEWER_URL=https://shl-viewer.example/  # SMART Health Link viewer URL; placeholder is fine for the demo
DEMO_NPI=1999999984                         # test NPI from the template; no lookup needed

# ============================================================
# Other
# ============================================================
# Backup voice provider (Option B), only if the Twilio bridge fails
RETELL_API_KEY=                             # Retell dashboard > API keys
VAPI_API_KEY=                               # Vapi dashboard > API keys

# Demo behavior
SIM_TIME_SCALE=1                            # 1 = simulated answers over 5-45 s; 0 = instant
SIM_A1_ANSWER=random                        # available | declined | random (only when there is no live call)
SWARM_TIMEOUT_SECONDS=90                    # our own setting
LIVE_CALL_TIMEOUT_S=240                     # our own setting

# Service URLs (local defaults; keep these filled, empty values break the services)
ORCHESTRATOR_URL=http://localhost:8000
OPENAI_SYNC_URL=http://localhost:8001
TWILIO_SYNC_URL=http://localhost:8002
COLLECTOR_URL=http://localhost:8003
HANDOFF_URL=http://localhost:8004
