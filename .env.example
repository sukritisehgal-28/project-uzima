# Copy to .env. Everything runs without any of these; each key switches one integration from mock to live.

# --- OpenAI (orchestrator summaries, personas, Realtime voice) ---
OPENAI_API_KEY=
OPENAI_MODEL=                 # chat model for personas; set to the model you have access to
OPENAI_MAX_CONCURRENT=5

# --- Twilio (live A1 call, SMS, physician bridge) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_HOST=                  # ngrok host for Twilio's media stream, e.g. abcd.ngrok-free.app
# Backup voice provider (Option B): one of
RETELL_API_KEY=
VAPI_API_KEY=

# --- Demo phones (teammates only, never real hospitals) ---
DEMO_HOSPITAL_PHONE=
DEMO_ACCEPTING_DOCTOR_PHONE=
DEMO_SENDING_DOCTOR_PHONE=

# --- AWS (off unless USE_AWS=1) ---
USE_AWS=0
AWS_REGION=us-east-1
DYNAMODB_TABLE=marco-polo
AWS_LOCATION_ROUTE_CALCULATOR=marco-polo-routes
AWS_LOCATION_MAP=marco-polo-map
LAUNCH_MODE=local             # local = in-process swarm; k8s = one Job per hospital
AGENT_IMAGE=marco-polo/agent:latest
K8S_NAMESPACE=marco-polo

# --- Handoff twin + insurance (Stedi mock mode) ---
STEDI_TEST_API_KEY=           # test key only; mock members below come from Stedi's docs
STEDI_MOCK_PAYER_ID=
STEDI_MOCK_MEMBER_ID=
STEDI_MOCK_FIRST=
STEDI_MOCK_LAST=
STEDI_MOCK_DOB=
SHL_VIEWER_URL=https://shl-viewer.example/
DEMO_NPI=1999999984

# --- Demo behavior ---
SIM_TIME_SCALE=1              # 1 = simulated answers land over 5-45 s; 0 = instant
SIM_A1_ANSWER=random          # available | declined | random (used only when there is no live call)
SWARM_TIMEOUT_SECONDS=90
LIVE_CALL_TIMEOUT_S=120

# --- Service URLs (defaults shown) ---
ORCHESTRATOR_URL=http://localhost:8000
OPENAI_SYNC_URL=http://localhost:8001
TWILIO_SYNC_URL=http://localhost:8002
COLLECTOR_URL=http://localhost:8003
HANDOFF_URL=http://localhost:8004
